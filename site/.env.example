# This is the intended canonical, not evidence of an active deployment.
SITE_URL=https://metaprev.forsvn.com
HOST=127.0.0.1
PORT=4323
# Enable only after the public domain and production response checks pass.
PUBLIC_INDEXING=off

# Actual account IDs and certified CMP adapter must come from the owner.
ADS_ENABLED=off
ADS_OWNER_APPROVED=off
ADS_SITE_APPROVED=off
ADS_PRIVACY_REVIEWED=off
ADS_CMP_READY=off
ADS_CSP_REVIEWED=off
# Separate opt-in verification before serving approval.
ADS_TXT_ENABLED=off
ADSENSE_CLIENT=
ADSENSE_SLOT=

# Optional fixed-route hourly counts in host logs; review host retention first.
# No visitor IDs, external collector, private reports, query strings or cookies.
ANALYTICS_ENABLED=off
ANALYTICS_OWNER_APPROVED=off
